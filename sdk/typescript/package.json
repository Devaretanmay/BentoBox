{
  "name": "@bentwork/sdk",
  "version": "0.9.4",
  "description": "BentoBox TypeScript SDK - sandbox any AI agent in seconds. Kernel-enforced isolation, deny-by-default, no containers, no VMs.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "build": "napi build --platform --release --cargo-cwd ./native .",
    "build:target": "napi build --platform --release --cargo-cwd ./native .",
    "test": "node test/smoke.mjs",
    "prepack": "npm run build:target"
  },
  "napi": {
    "name": "bentoworks-native",
    "triples": {
      "defaults": true
    },
    "binaryName": "bentoworks-native"
  },
  "optionalDependencies": {
    "@bentwork/sdk-darwin-arm64": "0.9.4",
    "@bentwork/sdk-darwin-x64": "0.9.4"
  },
  "engines": {
    "node": ">= 16.0.0"
  },
  "keywords": [
    "bentobox",
    "sandbox",
    "kernel",
    "isolation",
    "security",
    "landlock",
    "seatbelt",
    "compression",
    "ai",
    "agent",
    "compartment"
  ],
  "license": "BUSL-1.1",
  "author": "BentoBox Labs (Devaretanmay) <tanmaydevare@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Devaretanmay/BentoBox.git"
  },
  "homepage": "https://github.com/Devaretanmay/BentoBox#readme",
  "bugs": {
    "url": "https://github.com/Devaretanmay/BentoBox/issues"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
